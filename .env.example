# ============================================
# Google Ads Expert MCP Server
# Copie para .env e preencha com seus valores.
# NUNCA comita o arquivo .env com credenciais reais.
# ============================================

# --------------------------------------------
# Google Ads API (OAuth2)
# --------------------------------------------
# Developer Token: https://developers.google.com/google-ads/api/docs/first-call/dev-token
GOOGLE_ADS_DEVELOPER_TOKEN=

# Credenciais OAuth do projeto no Google Cloud Console
GOOGLE_ADS_CLIENT_ID=
GOOGLE_ADS_CLIENT_SECRET=

# Refresh token gerado via fluxo OAuth (tool run_setup ou install.py)
GOOGLE_ADS_REFRESH_TOKEN=

# ID da conta administradora (MCC) sem hifens. Opcional em autenticacao direta.
GOOGLE_ADS_LOGIN_CUSTOMER_ID=

# --------------------------------------------
# Worker MCP (HTTP/SSE)
# --------------------------------------------
# Token Bearer exigido pelo auth guard. Gere algo forte, ex: openssl rand -hex 32
MCP_AUTH_TOKEN=

# Host/porta do worker local (padroes: 127.0.0.1 e 8765)
MCP_HOST=127.0.0.1
MCP_PORT=8765
